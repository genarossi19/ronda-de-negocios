{
  "name": "ronda-de-negocios",
  "private": true,
  "version": "0.4.4",
  "description": "Sistema de gestión de Rondas de Negocios para la Subsecretaría de Desarrollo Económico y Productivo del Municipio de Trenque Lauquen, Buenos Aires, Argentina.",
  "author": {
    "name": "Genaro Rossi",
    "role": "Frontend Developer"
  },
  "contributors": [
    {
      "name": "Facundo Rivero",
      "role": "Backend Developer"
    },
    {
      "name": "Jessica Borla",
      "role": "Stakeholder / Product Owner"
    }
  ],
  "organization": {
    "name": "Subsecretaría de Desarrollo Económico y Productivo en conjunto con el Polo Científico Tecnológico",
    "location": "Trenque Lauquen, Buenos Aires, Argentina"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "release:rc": "npm version prerelease --preid=rc && npm run build && git push && git push --tags",
    "release:patch": "npm version patch && npm run build && git push && git push --tags",
    "release:minor": "npm version minor && npm run build && git push && git push --tags",
    "release:major": "npm version major && npm run build && git push && git push --tags",
    "build:local": "npm run clean && tsc -b && vite build",
    "version": "echo 'Nueva versión: ' && node -e \"console.log(require('./package.json').version)\""
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-image-crop": "^11.0.10",
    "react-router": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.10.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
